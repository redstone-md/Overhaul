{
  "schemaVersion": 1,
  "id": "overhaul",
  "version": "${version}",
  "name": "Overhaul",
  "description": "A Vulkan renderer for Minecraft with ray traced lighting, upscaling and its own settings screen.",
  "license": "GPL-3.0-only",
  "icon": "overhaul_logo.png",
  "contact": {"homepage": "https://github.com/redstone-md/Overhaul", "issues": "https://github.com/redstone-md/Overhaul/issues", "sources": "https://github.com/redstone-md/Overhaul"},
  "environment": "*",
  "entrypoints": {"main": ["dev.overhaul.minecraft.fabric.OverhaulFabric"]},
  "mixins": ["overhaul.mixins.json"],
  "depends": {"fabricloader": ">=${loaderVersion}", "minecraft": "${minecraft}"}
}
